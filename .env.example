NEXT_PUBLIC_API_GRAPHQL_URL=http://localhost:3007/graphql
NEXT_PUBLIC_API_WS_URL=ws://localhost:3007
NEXT_PUBLIC_API_URL=http://localhost:3007
# Public address of the site (used for canonical links, hreflang, sitemap.xml and robots.txt).
# Required for `yarn build` (the build fails without it); optional in development (falls back to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: mailbox shown on the contact page (defaults to a sample address on a demo domain)
NEXT_PUBLIC_CONTACT_EMAIL=hello@ticketzy.demo
