# Every NEXT_PUBLIC_* value is read at BUILD time and copied into the browser bundle: set it before `yarn build`.
# REQUIRED in production: `yarn build` stops with the missing names if one is unset. Development uses the local values below.

# REQUIRED. GraphQL endpoint of the backend
NEXT_PUBLIC_API_GRAPHQL_URL=http://localhost:3007/graphql
# REQUIRED. WebSocket address of the backend (messaging); wss:// in production
NEXT_PUBLIC_API_WS_URL=ws://localhost:3007
# REQUIRED. Base address of the backend, used for uploaded image paths
NEXT_PUBLIC_API_URL=http://localhost:3007
# REQUIRED. Public address of this site: canonical links, hreflang, sitemap.xml and robots.txt (development falls back to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Mailbox shown on the contact page (a sample address on a demo domain is shown without it)
NEXT_PUBLIC_CONTACT_EMAIL=hello@ticketzy.demo
